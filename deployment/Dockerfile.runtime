FROM python:3.12-slim-bookworm

# System dependencies for OpenCV and onnxruntime
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set up a non-root user
RUN groupadd -r containerid && useradd -r -g containerid -ms /bin/bash containerid

# Directory setup
RUN mkdir -p /opt/container-id/models \
    /etc/container-id \
    /var/lib/container-id \
    && chown -R containerid:containerid /opt/container-id /etc/container-id /var/lib/container-id

WORKDIR /app

# Install `uv`
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Copy dependencies manifest
COPY pyproject.toml .

# Install dependencies using `uv` to the system python environment
RUN uv pip install --system .[runtime,rtsp,api]

# Copy application source code
COPY src /app/src
COPY deployment/entrypoint.sh /app/entrypoint.sh

# Ensure script is executable and permissions are correct for /app
RUN chmod +x /app/entrypoint.sh && chown -R containerid:containerid /app

USER containerid

ENV PYTHONPATH=/app/src
ENV CONTAINER_ID_MODEL_DIR=/opt/container-id/models

# Expose FastAPI port
EXPOSE 8000

# Health check calling the api endpoint (avoiding raw 'exit')
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:8000/health

ENTRYPOINT ["/app/entrypoint.sh"]
